# Keep the existing Supabase values in your local .env.local file.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only: set locally in .env.local. Never prefix with NEXT_PUBLIC_.
GEMINI_API_KEY=
# Optional server-only model override. Verify availability in your Gemini account.
GEMINI_MODEL=gemini-3.5-flash-lite
